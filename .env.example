# Public, non-secret browser configuration.
NEXT_PUBLIC_ARC_CHAIN_ID=5042
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.mainnet.arc.io
NEXT_PUBLIC_ARC_EXPLORER_URL=https://explorer.arc.io
NEXT_PUBLIC_ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Leave both unset until the contract is deployed and verified. Without these,
# the application remains in explicit NOT_DEPLOYED / PREVIEW mode.
NEXT_PUBLIC_DUELET_CONTRACT_ADDRESS=
NEXT_PUBLIC_DUELET_DEPLOYMENT_BLOCK=

# Read-only RPC used by Foundry fork tests and release simulations.
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
