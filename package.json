{
  "name": "duelet",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "apps/*",
    "contracts",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm test && npm run secret:scan && git diff --check",
    "format": "prettier --write . && npm run format --workspace @duelet/contracts",
    "format:check": "prettier --check . && npm run format:check --workspace @duelet/contracts",
    "licenses:generate": "node scripts/generate-license-report.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "secret:scan": "bash scripts/secret-scan.sh",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
